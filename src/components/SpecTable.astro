---
import taksonomiJson from '../data/taksonomi.json';
import { formatAngka, labelKeandalan } from '../lib/format';

interface SpesifikasiItem {
  kunci: string;
  label: string;
  nilai: number | string;
  satuan?: string;
  catatan?: string;
  keandalan: 'resmi' | 'sekunder' | 'perkiraan';
  sumberId: string;
}

interface Props {
  jenis: string;
  spesifikasi: SpesifikasiItem[];
}

const { jenis, spesifikasi } = Astro.props;

const jenisInfo = taksonomiJson.jenis.find((j) => j.kunci === jenis);
const templatKey = jenisInfo?.templatSpesifikasi as keyof typeof taksonomiJson.templatSpesifikasi | undefined;
const templatFields = templatKey ? taksonomiJson.templatSpesifikasi[templatKey] || [] : [];

const specMap = new Map(spesifikasi.map((s) => [s.kunci, s]));
const usedKeys = new Set<string>();

interface BarisTampil {
  kunci: string;
  label: string;
  item?: SpesifikasiItem;
}

const baris: BarisTampil[] = [];

for (const field of templatFields) {
  usedKeys.add(field.kunci);
  baris.push({
    kunci: field.kunci,
    label: field.label,
    item: specMap.get(field.kunci),
  });
}

for (const sp of spesifikasi) {
  if (!usedKeys.has(sp.kunci)) {
    baris.push({
      kunci: sp.kunci,
      label: sp.label,
      item: sp,
    });
  }
}

function badgeKeandalanClass(k: string) {
  if (k === 'resmi') return 'bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-200 border-emerald-300 dark:border-emerald-800';
  if (k === 'sekunder') return 'bg-sky-100 text-sky-900 dark:bg-sky-950 dark:text-sky-200 border-sky-300 dark:border-sky-800';
  return 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200 border-amber-300 dark:border-amber-800';
}
---

<section aria-labelledby="heading-spesifikasi" class="space-y-3">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 id="heading-spesifikasi" class="text-xl font-bold text-slate-900 dark:text-white" data-i18n-id="Spesifikasi Teknis (Tingkat Katalog)" data-i18n-en="Technical Specifications (Catalog Level)">
      Spesifikasi Teknis (Tingkat Katalog)
    </h2>
    <span class="text-xs text-slate-600 dark:text-slate-400">
      Satuan disimpan dalam sistem metrik standar.
    </span>
  </div>

  <div class="terminal-panel overflow-x-auto">
    <div class="terminal-bar">
      <span>TABEL SPESIFIKASI &bull; {jenis.toUpperCase()}</span>
      <span>SATUAN METRIK (SI)</span>
    </div>
    <table class="w-full text-left text-base">
      <thead class="bg-slate-100 dark:bg-[#0d131c] text-slate-700 dark:text-slate-300 text-xs font-mono uppercase">
        <tr>
          <th scope="col" class="py-3.5 px-4 font-semibold">Parameter</th>
          <th scope="col" class="py-3.5 px-4 font-semibold">Nilai</th>
          <th scope="col" class="py-3.5 px-4 font-semibold">Keandalan Data</th>
          <th scope="col" class="py-3.5 px-4 font-semibold">Sumber</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 dark:divide-[#243244]">
        {baris.map((b) => (
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
            <th scope="row" class="py-3 px-4 font-medium text-slate-900 dark:text-slate-100">
              {b.label}
            </th>
            {b.item ? (
              <>
                <td
                  class="py-3.5 px-4 text-slate-800 dark:text-slate-200"
                  data-metric-val={typeof b.item.nilai === 'number' ? String(b.item.nilai) : undefined}
                  data-metric-unit={b.item.satuan || ''}
                >
                  <span class="spec-val font-semibold">{formatAngka(b.item.nilai)}</span>
                  {b.item.satuan && <span class="spec-unit ml-1 text-slate-600 dark:text-slate-400">{b.item.satuan}</span>}
                  {b.item.catatan && (
                    <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">{b.item.catatan}</p>
                  )}
                </td>
                <td class="py-3 px-4">
                  <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-medium border ${badgeKeandalanClass(b.item.keandalan)}`}>
                    {labelKeandalan(b.item.keandalan)}
                  </span>
                </td>
                <td class="py-3 px-4">
                  <a
                    href={`#sumber-${b.item.sumberId}`}
                    class="inline-flex items-center px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-xs font-mono font-semibold text-sky-700 dark:text-sky-400 hover:underline"
                  >
                    [{b.item.sumberId}]
                  </a>
                </td>
              </>
            ) : (
              <>
                <td class="py-3 px-4 italic text-slate-500 dark:text-slate-400" colspan="3">
                  Tidak dipublikasikan
                </td>
              </>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
