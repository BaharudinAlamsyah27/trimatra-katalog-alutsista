---
import {
  formatAngka,
  formatTanggalBulan,
  labelJenisJumlah,
  labelStatus,
  namaNegara,
} from '../lib/format';

interface PenggunaItem {
  negara: string;
  angkatan?: string;
  varian?: string;
  jumlah: number | null;
  jenisJumlah: 'dioperasikan' | 'dipesan' | 'dikirim' | 'perkiraan';
  tahunMulai?: number;
  tahunBerakhir?: number | null;
  status: 'aktif' | 'pensiun' | 'dipesan' | 'diketahui-tidak-pasti';
  perDate: string;
  catatan?: string;
  sumberId: string;
}

interface Props {
  pengguna: PenggunaItem[];
}

const { pengguna } = Astro.props;
---

<section aria-labelledby="heading-pengguna" class="space-y-3">
  <h2 id="heading-pengguna" class="text-xl font-bold text-slate-900 dark:text-white" data-i18n-id="Daftar Pengguna & Status Operasional" data-i18n-en="Operators & Operational Status">
    Daftar Pengguna & Status Operasional
  </h2>

  <div class="terminal-panel overflow-x-auto">
    <div class="terminal-bar">
      <span>DAFTAR PENGGUNA &bull; STATUS ARMADA</span>
      <span>ISO-3166</span>
    </div>
    <table class="w-full text-left text-base">
      <thead class="bg-slate-100 dark:bg-[#0d131c] text-slate-700 dark:text-slate-300 text-xs font-mono uppercase">
        <tr>
          <th scope="col" class="py-3.5 px-4 font-semibold">Negara & Angkatan</th>
          <th scope="col" class="py-3.5 px-4 font-semibold">Varian</th>
          <th scope="col" class="py-3.5 px-4 font-semibold">Jumlah & Tanggal Data</th>
          <th scope="col" class="py-3.5 px-4 font-semibold">Masa Dinas</th>
          <th scope="col" class="py-3.5 px-4 font-semibold">Status</th>
          <th scope="col" class="py-3.5 px-4 font-semibold">Sumber</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 dark:divide-[#243244]">
        {pengguna.map((p) => (
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
            <td class="py-3 px-4 font-medium text-slate-900 dark:text-slate-100">
              <div>
                <a href={`/pengguna/${p.negara.toLowerCase()}`} class="text-sky-700 dark:text-sky-400 hover:underline font-bold">
                  {namaNegara(p.negara)} ({p.negara})
                </a>
              </div>
              {p.angkatan && <div class="text-xs text-slate-600 dark:text-slate-400">{p.angkatan}</div>}
            </td>
            <td class="py-3 px-4 text-slate-800 dark:text-slate-200">
              {p.varian || '—'}
            </td>
            <td class="py-3 px-4 text-slate-800 dark:text-slate-200">
              <div>
                {p.jumlah !== null ? (
                  <span class="font-semibold">{formatAngka(p.jumlah)} unit</span>
                ) : (
                  <span class="italic text-slate-500 dark:text-slate-400">Tidak dipublikasikan</span>
                )}
                <span class="ml-1 text-xs text-slate-600 dark:text-slate-400">({labelJenisJumlah(p.jenisJumlah)})</span>
              </div>
              <div class="text-xs text-slate-600 dark:text-slate-400">
                per {formatTanggalBulan(p.perDate)}
              </div>
              {p.catatan && <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">{p.catatan}</p>}
            </td>
            <td class="py-3 px-4 text-slate-800 dark:text-slate-200">
              {p.tahunMulai ? `${p.tahunMulai}–${p.tahunBerakhir ?? 'sekarang'}` : '—'}
            </td>
            <td class="py-3 px-4">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200">
                {labelStatus(p.status)}
              </span>
            </td>
            <td class="py-3 px-4">
              <a
                href={`#sumber-${p.sumberId}`}
                class="inline-flex items-center px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-xs font-mono font-semibold text-sky-700 dark:text-sky-400 hover:underline"
              >
                [{p.sumberId}]
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
