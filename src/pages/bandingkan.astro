---
import Base from '../layouts/Base.astro';
import { getAllAlutsista, getAllPabrikan } from '../lib/derive';
import taksonomiJson from '../data/taksonomi.json';
import { labelJenis, labelMatra, namaNegara } from '../lib/format';

const semuaAlutsista = await getAllAlutsista();
const semuaPabrikan = await getAllPabrikan();
const pabrikanMap = Object.fromEntries(semuaPabrikan.map((p) => [p.id, p.data.nama]));

const clientDataset = semuaAlutsista.map((e) => ({
  slug: e.id,
  nama: e.data.nama,
  matra: e.data.matra,
  matraLabel: labelMatra(e.data.matra),
  jenis: e.data.jenis,
  jenisLabel: labelJenis(e.data.jenis),
  negaraAsal: e.data.negaraAsal.map((k) => `${namaNegara(k)} (${k})`).join(', '),
  pabrikan: e.data.pabrikan.map((p) => pabrikanMap[p.id] || p.id).join(', '),
  tahunMulaiDinas: e.data.tahunMulaiDinas ?? null,
  peran: e.data.peran,
  poster: e.data.model3d?.poster || e.data.galeri[0]?.berkas || '',
  spesifikasi: e.data.spesifikasi,
}));

const clientTaxonomy = {
  jenis: taksonomiJson.jenis,
  templatSpesifikasi: taksonomiJson.templatSpesifikasi,
};
---

<Base
  judul="Bandingkan Alutsista Sejenis"
  deskripsi="Bandingkan 2 hingga 3 alutsista sejenis secara berdampingan berdasarkan parameter spesifikasi metrik yang setara."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <header class="space-y-2">
      <p class="text-sm font-mono font-semibold text-emerald-700 dark:text-emerald-400">
        /bandingkan &bull; Perbandingan Spesifikasi Metrik
      </p>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white" data-i18n-id="Bandingkan Alutsista Sejenis" data-i18n-en="Compare Equipment">
        Bandingkan Alutsista Sejenis
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-300">
        Pilih jenis alutsista, lalu pilih 2 hingga 3 entri untuk membandingkan bidang spesifikasi teknis yang sama secara berdampingan. Tautan URL otomatis diperbarui agar dapat dibagikan.
      </p>
    </header>

    <section aria-label="Pemilih perbandingan alutsista" class="terminal-panel">
      <div class="terminal-bar">
        <span>KONSOL PERBANDINGAN</span>
        <span class="text-emerald-700 dark:text-emerald-400">SINKRONISASI URL AKTIF</span>
      </div>
      <div class="p-5 sm:p-6 space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <label for="cmp-jenis" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
            1. Pilih Jenis Alutsista
          </label>
          <select
            id="cmp-jenis"
            class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-sm text-slate-900 dark:text-white"
          ></select>
        </div>

        <div>
          <label for="cmp-item-1" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
            2. Alutsista Pertama
          </label>
          <select
            id="cmp-item-1"
            class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-sm text-slate-900 dark:text-white"
          ></select>
        </div>

        <div>
          <label for="cmp-item-2" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
            3. Alutsista Kedua
          </label>
          <select
            id="cmp-item-2"
            class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-sm text-slate-900 dark:text-white"
          ></select>
        </div>

        <div>
          <label for="cmp-item-3" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
            4. Alutsista Ketiga (Opsional)
          </label>
          <select
            id="cmp-item-3"
            class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-sm text-slate-900 dark:text-white"
          ></select>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-slate-100 dark:border-slate-800 text-xs">
        <p id="cmp-status" class="text-slate-600 dark:text-slate-400">
          Parameter URL siap dibagikan.
        </p>
        <button
          id="btn-copy-cmp-url"
          type="button"
          class="px-3 py-1.5 rounded-md bg-slate-900 dark:bg-sky-600 text-white font-semibold hover:bg-slate-800 dark:hover:bg-sky-500"
        >
          Salin Tautan Perbandingan
        </button>
      </div>
      </div>
    </section>

    <div id="cmp-radar-container" class="hidden terminal-panel p-5 sm:p-6"></div>

    <div id="cmp-table-container" class="terminal-panel overflow-x-auto"></div>
  </div>

  <script
    is:inline
    define:vars={{ clientDataset, clientTaxonomy }}
  >
    const selJenis = document.getElementById('cmp-jenis');
    const sel1 = document.getElementById('cmp-item-1');
    const sel2 = document.getElementById('cmp-item-2');
    const sel3 = document.getElementById('cmp-item-3');
    const container = document.getElementById('cmp-table-container');
    const radarContainer = document.getElementById('cmp-radar-container');
    const btnCopy = document.getElementById('btn-copy-cmp-url');
    const statusText = document.getElementById('cmp-status');

    function fmtNum(val) {
      if (typeof val === 'number') {
        return new Intl.NumberFormat('id-ID', { maximumFractionDigits: 2 }).format(val);
      }
      return String(val);
    }

    // Group entries by jenis
    const byJenis = new Map();
    for (const item of clientDataset) {
      const arr = byJenis.get(item.jenis) || [];
      arr.push(item);
      byJenis.set(item.jenis, arr);
    }

    // Populate jenis options (prioritize jenis with >= 2 entries)
    const availableJenis = clientTaxonomy.jenis.filter((j) => (byJenis.get(j.kunci) || []).length > 0);
    availableJenis.sort((a, b) => (byJenis.get(b.kunci)?.length || 0) - (byJenis.get(a.kunci)?.length || 0));

    selJenis.innerHTML = availableJenis
      .map((j) => {
        const count = (byJenis.get(j.kunci) || []).length;
        return `<option value="${j.kunci}">${j.label} (${count} entri)</option>`;
      })
      .join('');

    function populateSelectors(jenisKey, preselectedSlugs = []) {
      const list = byJenis.get(jenisKey) || [];
      const optsHtml = list.map((e) => `<option value="${e.slug}">${e.nama}</option>`).join('');
      sel1.innerHTML = optsHtml;
      sel2.innerHTML = `<option value="">— Pilih —</option>` + optsHtml;
      sel3.innerHTML = `<option value="">— Tidak dipilih —</option>` + optsHtml;

      const validSlugs = preselectedSlugs.filter((s) => list.some((e) => e.slug === s));
      if (validSlugs.length >= 1) {
        sel1.value = validSlugs[0];
        sel2.value = validSlugs[1] || (list[1]?.slug !== validSlugs[0] ? list[1]?.slug || '' : '');
        sel3.value = validSlugs[2] || '';
      } else {
        sel1.value = list[0]?.slug || '';
        sel2.value = list[1]?.slug || '';
        sel3.value = '';
      }
    }

    function renderComparison() {
      const jenisKey = selJenis.value;
      const slugs = [sel1.value, sel2.value, sel3.value].filter(Boolean);
      const uniqueSlugs = Array.from(new Set(slugs));
      const chosen = uniqueSlugs
        .map((s) => clientDataset.find((e) => e.slug === s))
        .filter(Boolean);

      // Update URL
      const url = new URL(window.location.href);
      url.searchParams.set('jenis', jenisKey);
      url.searchParams.set('items', uniqueSlugs.join(','));
      window.history.replaceState({}, '', url.toString());

      if (chosen.length < 2) {
        if (radarContainer) radarContainer.classList.add('hidden');
        container.innerHTML = `
          <div class="p-8 text-center text-sm text-slate-600 dark:text-slate-400">
            Pilih minimal <strong>2 alutsista berbeda</strong> pada jenis ini untuk menampilkan tabel perbandingan berdampingan.
          </div>
        `;
        return;
      }

      // Render Diagram Radar SVG (parameter numerik yang tersedia di semua/sebagian unit)
      if (radarContainer) {
        const numericAxes = templatFields
          .filter((f) => f.tipe === 'angka')
          .map((f) => {
            const vals = chosen.map((c) => {
              const s = c.spesifikasi.find((x) => x.kunci === f.kunci);
              return s && typeof s.nilai === 'number' ? s.nilai : 0;
            });
            return { label: f.label, max: Math.max(...vals, 0), vals };
          })
          .filter((a) => a.max > 0)
          .slice(0, 6);

        if (numericAxes.length >= 3) {
          const cx = 160, cy = 140, R = 95, n = numericAxes.length;
          const colors = ['#10b981', '#06b6d4', '#f59e0b'];
          const rings = [0.33, 0.66, 1].map((r) => {
            const pts = numericAxes
              .map((_, i) => {
                const ang = (Math.PI * 2 * i) / n - Math.PI / 2;
                return `${(cx + R * r * Math.cos(ang)).toFixed(1)},${(cy + R * r * Math.sin(ang)).toFixed(1)}`;
              })
              .join(' ');
            return `<polygon points="${pts}" fill="none" stroke="rgba(148,163,184,0.22)" stroke-width="1" />`;
          }).join('');

          const axesSvg = numericAxes.map((ax, i) => {
            const ang = (Math.PI * 2 * i) / n - Math.PI / 2;
            const x2 = cx + R * Math.cos(ang);
            const y2 = cy + R * Math.sin(ang);
            const lx = cx + (R + 18) * Math.cos(ang);
            const ly = cy + (R + 18) * Math.sin(ang);
            const anchor = Math.cos(ang) > 0.2 ? 'start' : Math.cos(ang) < -0.2 ? 'end' : 'middle';
            return `
              <line x1="${cx}" y1="${cy}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" stroke="rgba(148,163,184,0.2)" stroke-width="1" />
              <text x="${lx.toFixed(1)}" y="${ly.toFixed(1)}" text-anchor="${anchor}" fill="#94a3b8" font-size="10" font-family="monospace">${ax.label}</text>
            `;
          }).join('');

          const polys = chosen.map((c, ci) => {
            const pts = numericAxes.map((ax, i) => {
              const ratio = ax.max > 0 ? Math.max(0.1, ax.vals[ci] / ax.max) : 0.1;
              const ang = (Math.PI * 2 * i) / n - Math.PI / 2;
              return `${(cx + R * ratio * Math.cos(ang)).toFixed(1)},${(cy + R * ratio * Math.sin(ang)).toFixed(1)}`;
            }).join(' ');
            const col = colors[ci % colors.length];
            return `<polygon points="${pts}" fill="${col}" fill-opacity="0.18" stroke="${col}" stroke-width="2" />`;
          }).join('');

          const legend = chosen.map((c, ci) => `
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200">
              <span class="w-2.5 h-2.5 rounded-full" style="background:${colors[ci % colors.length]}"></span>
              ${c.nama}
            </span>
          `).join('');

          radarContainer.classList.remove('hidden');
          radarContainer.innerHTML = `
            <div class="flex flex-col md:flex-row items-center justify-between gap-6">
              <div class="space-y-2 max-w-sm">
                <p class="text-xs font-mono uppercase tracking-wider text-emerald-700 dark:text-emerald-400 font-bold">Grafik Radar Parameter Numerik</p>
                <p class="text-sm text-slate-600 dark:text-slate-300">Visualisasi perbandingan relatif antar alutsista terpilih (dinormalisasi terhadap nilai tertinggi di antara unit yang dibandingkan).</p>
                <div class="flex flex-wrap gap-3 pt-1">${legend}</div>
              </div>
              <svg viewBox="0 0 320 280" class="w-full max-w-[340px] h-auto shrink-0" role="img" aria-label="Grafik radar perbandingan spesifikasi">
                ${rings}${axesSvg}${polys}
              </svg>
            </div>
          `;
        } else {
          radarContainer.classList.add('hidden');
        }
      }

      const jenisObj = clientTaxonomy.jenis.find((j) => j.kunci === jenisKey);
      const templatKey = jenisObj?.templatSpesifikasi;
      const templatFields = (templatKey && clientTaxonomy.templatSpesifikasi[templatKey]) || [];

      const headerCols = chosen
        .map(
          (item) => `
          <th scope="col" class="py-4 px-4 align-top min-w-[220px]">
            <a href="/alutsista/${item.slug}" class="block space-y-2 group">
              ${
                item.poster
                  ? `<img src="${item.poster}" alt="Poster ${item.nama}" class="h-28 w-full object-contain rounded-lg bg-slate-100 dark:bg-slate-800 p-2" width="320" height="200" />`
                  : ''
              }
              <div class="text-base font-bold text-slate-900 dark:text-white group-hover:text-sky-600">${item.nama}</div>
              <div class="text-xs font-normal text-slate-500">${item.negaraAsal} • ${item.pabrikan}</div>
            </a>
          </th>
        `
        )
        .join('');

      const metaRows = [
        {
          label: 'Tahun Mulai Dinas',
          render: (item) => (item.tahunMulaiDinas ? String(item.tahunMulaiDinas) : '<span class="italic text-slate-400">Tidak dipublikasikan</span>'),
        },
        {
          label: 'Peran Utama',
          render: (item) => `<span class="text-xs">${item.peran}</span>`,
        },
      ];

      const metaHtml = metaRows
        .map(
          (row) => `
          <tr class="border-b border-slate-200 dark:border-slate-800">
            <th scope="row" class="py-3 px-4 font-semibold text-slate-900 dark:text-slate-100 bg-slate-50/60 dark:bg-slate-800/40 w-52">${row.label}</th>
            ${chosen.map((item) => `<td class="py-3 px-4 text-slate-800 dark:text-slate-200">${row.render(item)}</td>`).join('')}
          </tr>
        `
        )
        .join('');

      const specRowsHtml = templatFields
        .map((field) => {
          const cells = chosen
            .map((item) => {
              const sp = item.spesifikasi.find((s) => s.kunci === field.kunci);
              if (!sp) {
                return `<td class="py-3 px-4 italic text-slate-400">Tidak dipublikasikan</td>`;
              }
              const valStr = fmtNum(sp.nilai) + (sp.satuan ? ` ${sp.satuan}` : '');
              const noteStr = sp.catatan ? `<div class="text-xs text-slate-500 mt-0.5">${sp.catatan}</div>` : '';
              return `
                <td class="py-3 px-4 text-slate-800 dark:text-slate-200">
                  <div class="font-semibold">${valStr}</div>
                  ${noteStr}
                  <div class="text-[11px] text-slate-500 mt-0.5 uppercase font-mono">${sp.keandalan} • <a href="/alutsista/${item.slug}#sumber-${sp.sumberId}" class="text-sky-600 hover:underline">[${sp.sumberId}]</a></div>
                </td>
              `;
            })
            .join('');

          return `
            <tr class="border-b border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/30">
              <th scope="row" class="py-3 px-4 font-medium text-slate-900 dark:text-slate-100 bg-slate-50/60 dark:bg-slate-800/40">${field.label}</th>
              ${cells}
            </tr>
          `;
        })
        .join('');

      container.innerHTML = `
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-100 dark:bg-slate-800/90 border-b border-slate-200 dark:border-slate-800">
            <tr>
              <th scope="col" class="py-4 px-4 font-bold text-xs uppercase text-slate-600 dark:text-slate-300 w-52">Spesifikasi (${jenisObj?.label || ''})</th>
              ${headerCols}
            </tr>
          </thead>
          <tbody>
            ${metaHtml}
            ${specRowsHtml}
          </tbody>
        </table>
      `;
    }

    // Parse initial URL query params
    const initParams = new URLSearchParams(window.location.search);
    const paramItems = (initParams.get('items') || '')
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    let initJenis = initParams.get('jenis') || '';

    if (!initJenis && paramItems.length > 0) {
      const firstFound = clientDataset.find((e) => e.slug === paramItems[0]);
      if (firstFound) initJenis = firstFound.jenis;
    }

    if (initJenis && availableJenis.some((j) => j.kunci === initJenis)) {
      selJenis.value = initJenis;
    }

    populateSelectors(selJenis.value, paramItems);
    renderComparison();

    selJenis.addEventListener('change', () => {
      populateSelectors(selJenis.value, []);
      renderComparison();
    });
    [sel1, sel2, sel3].forEach((s) => s.addEventListener('change', renderComparison));

    btnCopy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (statusText) statusText.textContent = 'Tautan perbandingan berhasil disalin ke papan klip!';
      } catch {
        if (statusText) statusText.textContent = 'Salin URL langsung dari bilah alamat peramban.';
      }
    });
  </script>
</Base>
