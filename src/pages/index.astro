  <script>
    const clockEl = document.getElementById('live-wib-clock');
    function updateClock() {
      if (!clockEl) return;
      const now = new Date();
      const fmt = new Intl.DateTimeFormat('id-ID', {
        timeZone: 'Asia/Jakarta',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      }).format(now);
      clockEl.textContent = `${fmt.replaceAll('.', ':')} WIB`;
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
