---
import Base from '../../layouts/Base.astro';

const armadaAngkut = [
  { slug: 'c-130-hercules', nama: 'C-130J-30 / C-130H Hercules', payloadKg: 20000, speedKmh: 590, rangeKm: 3800, tipe: 'Pesawat Angkut Berat' },
  { slug: 'cn-235-220', nama: 'CN235-220', payloadKg: 6000, speedKmh: 450, rangeKm: 4355, tipe: 'Pesawat Angkut Medium' },
  { slug: 'nc212i', nama: 'NC212i', payloadKg: 2800, speedKmh: 360, rangeKm: 1680, tipe: 'Pesawat Angkut Ringan' },
  { slug: 'h225m-caracal', nama: 'H225M Caracal', payloadKg: 4750, speedKmh: 262, rangeKm: 920, tipe: 'Helikopter Angkut Berat' },
  { slug: 'kapal-amfibi-kelas-makassar', nama: 'LPD Kelas Makassar', payloadKg: 1500000, speedKmh: 29, rangeKm: 18520, tipe: 'Kapal Angkut Amfibi (Laut)' },
];
---

<Base
  judul="Kalkulator Logistik & Bantuan Bencana (HADR)"
  deskripsi="Simulasi edukatif perhitungan jumlah sorti dan waktu tempuh angkutan bantuan kemanusiaan serta logistik Nusantara."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <header class="space-y-2">
      <p class="text-sm font-mono font-semibold text-emerald-700 dark:text-emerald-400">
        /simulasi/logistik &bull; Kalkulator HADR (Humanitarian Assistance &amp; Disaster Relief)
      </p>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
        Kalkulator Angkut Logistik &amp; Bantuan Bencana
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-300 max-w-3xl">
        Estimasi matematis jumlah sorti (perjalanan bolak-balik) dan total jam operasional untuk mengangkut logistik bantuan menuju lokasi bencana.
      </p>
    </header>

    <section class="terminal-panel">
      <div class="terminal-bar">
        <span>PARAMETER MISI BANTUAN LOGISTIK</span>
        <span class="text-emerald-700 dark:text-emerald-400">ESTIMASI EDUKATIF</span>
      </div>

      <div class="p-5 sm:p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <div>
            <label for="log-unit" class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-1.5">
              1. Armada Pengangkut
            </label>
            <select id="log-unit" class="w-full min-h-[44px] px-3 py-2 rounded-lg border border-slate-300 dark:border-[#2c3c52] bg-slate-50 dark:bg-[#0b1017] text-sm text-slate-900 dark:text-white">
              {armadaAngkut.map((u) => (
                <option value={u.slug}>{u.nama} (Muatan {(u.payloadKg / 1000).toLocaleString('id-ID')} ton)</option>
              ))}
            </select>
          </div>

          <div>
            <div class="flex justify-between text-sm mb-1.5">
              <label for="log-ton" class="font-semibold text-slate-700 dark:text-slate-200">2. Total Bantuan (Ton)</label>
              <span id="log-ton-val" class="font-mono font-bold text-emerald-700 dark:text-emerald-400">60 ton</span>
            </div>
            <input id="log-ton" type="range" min="5" max="300" step="5" value="60" class="w-full accent-emerald-500 cursor-pointer" />
          </div>

          <div>
            <div class="flex justify-between text-sm mb-1.5">
              <label for="log-dist" class="font-semibold text-slate-700 dark:text-slate-200">3. Jarak Rute (km)</label>
              <span id="log-dist-val" class="font-mono font-bold text-cyan-700 dark:text-cyan-400">1.200 km</span>
            </div>
            <input id="log-dist" type="range" min="100" max="4000" step="50" value="1200" class="w-full accent-cyan-500 cursor-pointer" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-4 rounded-xl border border-emerald-500/35 bg-emerald-500/5">
            <div class="text-xs font-mono uppercase text-emerald-700 dark:text-emerald-400 font-bold">Jumlah Sorti</div>
            <div id="out-sorties" class="text-3xl font-extrabold tabular-nums text-slate-900 dark:text-white mt-1">—</div>
            <div id="out-payload" class="text-xs text-slate-600 dark:text-slate-300 mt-1">—</div>
          </div>
          <div class="p-4 rounded-xl border border-cyan-500/35 bg-cyan-500/5">
            <div class="text-xs font-mono uppercase text-cyan-700 dark:text-cyan-400 font-bold">Waktu 1x Jalan</div>
            <div id="out-oneway" class="text-3xl font-extrabold tabular-nums text-slate-900 dark:text-white mt-1">—</div>
            <div id="out-speed" class="text-xs text-slate-600 dark:text-slate-300 mt-1">—</div>
          </div>
          <div class="p-4 rounded-xl border border-slate-200 dark:border-[#243244] bg-white dark:bg-[#111822]">
            <div class="text-xs font-mono uppercase text-slate-500 dark:text-slate-400 font-bold">Total Jam Perjalanan</div>
            <div id="out-total-time" class="text-3xl font-extrabold tabular-nums text-slate-900 dark:text-white mt-1">—</div>
            <div id="out-range-note" class="text-xs mt-1">—</div>
          </div>
        </div>

        <p class="text-xs text-slate-500 dark:text-slate-400">
          Catatan edukasi: Perhitungan menggunakan kapasitas angkut katalog maksimum &amp; kecepatan jelajah tanpa memperhitungkan waktu bongkar-muat di landasan/pelabuhan maupun kondisi cuaca.
        </p>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ armadaAngkut }}>
    const selUnit = document.getElementById('log-unit');
    const sliderTon = document.getElementById('log-ton');
    const sliderDist = document.getElementById('log-dist');
    const tonVal = document.getElementById('log-ton-val');
    const distVal = document.getElementById('log-dist-val');

    const outSorties = document.getElementById('out-sorties');
    const outPayload = document.getElementById('out-payload');
    const outOneway = document.getElementById('out-oneway');
    const outSpeed = document.getElementById('out-speed');
    const outTotal = document.getElementById('out-total-time');
    const outRange = document.getElementById('out-range-note');

    function fmtDur(h) {
      const m = Math.round(h * 60);
      const jam = Math.floor(m / 60);
      const min = m % 60;
      if (jam === 0) return `${min} menit`;
      if (min === 0) return `${jam} jam`;
      return `${jam} jam ${min} mnt`;
    }

    function update() {
      const u = armadaAngkut.find((a) => a.slug === selUnit.value) || armadaAngkut[0];
      const totalTon = Number(sliderTon.value);
      const distKm = Number(sliderDist.value);
      if (tonVal) tonVal.textContent = `${totalTon} ton`;
      if (distVal) distVal.textContent = `${new Intl.NumberFormat('id-ID').format(distKm)} km`;

      const capTon = u.payloadKg / 1000;
      const sorties = Math.max(1, Math.ceil(totalTon / capTon));
      const oneWayH = distKm / u.speedKmh;
      const totalLegs = sorties === 1 ? 1 : sorties * 2 - 1;
      const totalH = oneWayH * totalLegs;

      if (outSorties) outSorties.textContent = `${sorties} sorti`;
      if (outPayload) outPayload.textContent = `Kapasitas per sorti: ${capTon.toLocaleString('id-ID')} ton`;
      if (outOneway) outOneway.textContent = fmtDur(oneWayH);
      if (outSpeed) outSpeed.textContent = `Kecepatan jelajah: ${u.speedKmh} km/jam`;
      if (outTotal) outTotal.textContent = fmtDur(totalH);
      if (outRange) {
        const ok = distKm <= u.rangeKm;
        outRange.textContent = ok
          ? `Dalam jangkauan langsung (${u.rangeKm.toLocaleString('id-ID')} km)`
          : `Melebihi jarak langsung (${u.rangeKm.toLocaleString('id-ID')} km) — perlu transit`;
        outRange.className = ok ? 'text-xs mt-1 text-emerald-600 dark:text-emerald-400' : 'text-xs mt-1 text-amber-600 dark:text-amber-400';
      }
    }

    [selUnit, sliderTon, sliderDist].forEach((el) => el?.addEventListener('input', update));
    update();
  </script>
</Base>
